{
  "name": "meugasto-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/main.ts",
    "email:preview": "ts-node -T scripts/preview-emails.ts",
