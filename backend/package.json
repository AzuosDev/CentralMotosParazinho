    "@types/jest": "^29.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "^2.0.12",
    "jest": "^29.0.0",
    "mongodb-memory-server": "^9.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
